// Mathematical transcription of RFC 8439 sections 2.1 and 2.1.1.
// https://www.rfc-editor.org/rfc/rfc8439#section-2.1.1
// This assertion reproduces one known answer; it is not a proof.
edition 2026;
module rfc8439_example {
  type Quad = (Word[32], Word[32], Word[32], Word[32]);
  spec quarter(a: Word[32], b: Word[32], c: Word[32], d: Word[32]) -> Quad {
    let a1: Word[32] = a + b;
    let d1: Word[32] = (d ^ a1) <<< 16;
    let c1: Word[32] = c + d1;
    let b1: Word[32] = (b ^ c1) <<< 12;
    let a2: Word[32] = a1 + b1;
    let d2: Word[32] = (d1 ^ a2) <<< 8;
    let c2: Word[32] = c1 + d2;
    let b2: Word[32] = (b1 ^ c2) <<< 7;
    (a2, b2, c2, d2)
  }
  test "RFC 8439 section 2.1.1: quarter round" {
    quarter(0x11111111, 0x01020304, 0x9b8d6f43, 0x01234567)
      == (0xea2a92f4, 0xcb1cf8ce, 0x4581472e, 0x5881c4bb)
  }
}
